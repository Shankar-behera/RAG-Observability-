# Copy this file to .env and fill in real values for the provider you want to use.

# ---- LLM provider: openai | deepseek | ollama ----
LLM_PROVIDER=ollama

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Used if LLM_PROVIDER=ollama (run `ollama pull mistral` first)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:latest

# ---- Embeddings (local, no API key, downloads from huggingface.co on first run) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store: chroma | pgvector ----
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=rag_documents

PG_DSN=postgresql://raguser:ragpass@localhost:5432/rag_observability
PG_TABLE=rag_documents

# ---- App ----
TOP_K=4
FAITHFULNESS_GATE=0.85
CORS_ORIGINS=http://localhost:3000
